# The image contains only the private proxy. Add MCP servers to its config.
PG_IMAGE=privacy-gateway:local
PG_PORT=8000
PG_SOURCES=source_data
PG_WORKSPACE=work_data
PG_CONFIG=./config.container.example.toml
# For host backends, bind an EXISTING private workspace and sources:
# PG_SOURCES=/home/user/Documents/approved
# PG_WORKSPACE=/home/user/private-proxy-workspace
# PG_CONFIG=./config.container.toml
# Windows paths use forward slashes. Backends use workspace_path for host paths.
PG_BACKEND_ENV_FILE=./backend-secrets.example.env
